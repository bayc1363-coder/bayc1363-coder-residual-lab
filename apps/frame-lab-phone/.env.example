# Copy to .env.local for live DeepSeek / Experiential Labs.
# Without a key the app uses a local mock model so the demo still works.

# Preferred (Experiential Labs)
EXPLABS_API_KEY=

# Also accepted
# OPENAI_API_KEY=

# OpenAI-compatible host. /v1 is appended if missing.
BASE_URL=https://api.experientiallabs.ai

# Model slug
MODEL=deepseek-v4.1-flash
# MODEL=deepseek-chat

# Optional paid web search. Without these, Search uses DuckDuckGo (no key).
# TAVILY_API_KEY=
# BRAVE_API_KEY=
